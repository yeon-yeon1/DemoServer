# 서버의 APP_DIR에 .env 로 복사해서 실제 값을 채운다. 절대 커밋하지 않는다.
# DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT/COOKIE_SECURE 는
# docker-compose.prod.yml 의 environment 가 덮어쓰므로 여기 둘 필요 없다.

# MySQL
DB_NAME=duksungmap
DB_USER=duksungmap
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT (openssl rand -base64 64)
JWT_SECRET=

# SMTP (587 STARTTLS)
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
